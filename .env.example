# =============================================================================
# BizFlow — Environment Variables
# Production values are set in Coolify's UI — never commit a .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# On Coolify: use the Internal Connection URL from your managed Postgres.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:changeme@localhost:5432/bizzflow

# -----------------------------------------------------------------------------
# Session / JWT signing
# A long random string used to sign JWT tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
SESSION_SECRET=change-this-to-a-long-random-string-at-least-64-chars

# -----------------------------------------------------------------------------
# File uploads
# Local-disk storage for uploaded files (e.g. visualiser photos). In Docker
# this is a mounted volume (see docker-compose.yml); locally it can be any
# writable directory.
# -----------------------------------------------------------------------------
PRIVATE_UPLOAD_DIR=./data/uploads

# -----------------------------------------------------------------------------
# Platform admin bootstrap (optional)
# Only used the FIRST time each platform admin account is created — existing
# accounts are never modified, so this is safe to leave unset after go-live.
# -----------------------------------------------------------------------------
SEED_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Platform admin BREAK-GLASS (leave unset in normal operation)
# SEED_ADMIN_PASSWORD above cannot recover a lost password — it only creates
# missing accounts. This pair create-or-RESETS the platform admin and forces the
# account to SUPER_ADMIN so it lands on /admin rather than a single dashboard.
# Set in Coolify, deploy, log in, then REMOVE: while set, every deploy resets
# the password, silently reverting any change made from inside the app.
# PLATFORM_ADMIN_EMAIL defaults to launchflowuk@gmail.com when blank.
# -----------------------------------------------------------------------------
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_EMAIL=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Shared secret for the internal job endpoints under /internal/jobs/*.
# While unset those endpoints return 404, so a deploy without it is safe — the
# automations simply never sweep. Generate one with:
#   openssl rand -hex 32
JOBS_SECRET=

# Public origin used to build customer-facing links: payment pages and the
# private calendar feed URL. Defaults to https://bizzflowuk.com.
PUBLIC_BASE_URL=https://bizzflowuk.com

# --- Accounting (migration 0052) -------------------------------------------
# App registrations, one per provider, held at the PLATFORM level rather than
# per tenant: each tenant consents through OAuth, they never paste a key.
#
# Until a pair is set, that provider shows in the dashboard as "not available
# yet" with its Connect button disabled -- deliberately, so nobody is sent to
# an authorise page that cannot work.
#
# Xero:      https://developer.xero.com/app/manage
# FreeAgent: https://dev.freeagent.com/apps
#
# The redirect URI to register for each is:
#   https://bizzflowuk.com/api/accounting/callback/xero
#   https://bizzflowuk.com/api/accounting/callback/freeagent
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=
# Set to 1 to point FreeAgent at its sandbox while testing.
FREEAGENT_SANDBOX=

# Xero webhook signing key, from the Webhooks tab of the app in Xero.
#
# Without it EVERY delivery is rejected with 401 -- which is the safe failure,
# but it also means Xero's setup validation never passes and the webhook is
# switched off. Set this BEFORE saving the webhook in Xero.
#
# The delivery URL to give Xero is:
#   https://bizzflowuk.com/api/accounting/webhook/xero
XERO_WEBHOOK_KEY=
